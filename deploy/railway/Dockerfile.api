FROM node:22-slim AS base

# Install system dependencies (git needed for some npm packages)
RUN apt-get update && apt-get install -y git python3 make g++ && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate

WORKDIR /app

# Copy workspace config and package files
COPY pnpm-workspace.yaml package.json ./
COPY pnpm-lock.yaml* ./

# Copy all workspace package.json files
COPY ui-admin/package.json ./ui-admin/
COPY ui-chat/package.json ./ui-chat/
COPY ui/package.json ./ui/

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY src/ ./src/
COPY tsconfig.json ./
COPY deploy/railway/entrypoint.ts ./deploy/railway/entrypoint.ts

# Expose port
ENV ADMIN_API_PORT=3000
EXPOSE 3000

# Run migrations then start server
CMD ["node", "--import", "tsx", "deploy/railway/entrypoint.ts"]
